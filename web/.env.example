# Go Web 服务器（web/server）配置示例。复制为 web/server/.env 或直接 export。

# 监听端口
PORT=8080

# 你的自托管 Gitea
GITEA_URL=http://localhost:3000

# 在 Gitea「设置 → 应用 → 创建新的 OAuth2 应用」里注册后填这两项；
# 重定向 URI 填下面的 OAUTH_REDIRECT_URL。仅生产/OAuth 登录需要；
# 本地自测可用 DEV=1 的 PAT 登录，先不填。
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URL=http://localhost:8080/auth/callback

# Python 记忆 API（locket serve-api）的地址，Go 把 /api/* 反代到这里
LOCKET_API_URL=http://127.0.0.1:8723

# 签名会话 cookie 的密钥：openssl rand -hex 32
SESSION_SECRET=

# 开发模式：启用 POST /auth/token（用 Gitea 个人令牌 PAT 登录，免注册 OAuth 应用）
DEV=1

# 构建好的前端静态目录（生产用）
STATIC_DIR=../app/dist
